{
  "name": "healthtrack-symptom-tracker",
  "version": "1.0.0",
  "description": "HealthTrack - Patient Symptom Tracker web application with REST API, SQLite persistence, and severity trend visualization.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "seed": "node src/db/seed.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "healthcare",
    "symptom-tracker",
    "patient-portal",
    "sqlite"
  ],
  "license": "MIT"
}
